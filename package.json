{
  "name": "gekon-ips-control",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --hostname 0.0.0.0",
    "build": "vinext build",
    "start": "vinext start",
    "postinstall": "node scripts/patch-vinext-windows-static-assets.mjs",
    "start:share": "node scripts/start-share.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:mcp": "node --import tsx --test tests/mcp/all.test.ts",
    "test:tracking": "node --import tsx --test tests/trackingIngest.test.ts tests/regionPositionEngine.test.ts tests/processedPositionServer.test.ts tests/regionEngineApi.test.ts tests/positionAnimationController.test.ts tests/demoSharing.test.ts tests/tagSimulator.test.mjs",
    "test:maps": "node --import tsx --test tests/mapCatalog.test.ts tests/mapSelection.test.ts tests/mapViewportConfig.test.ts",
    "test:mcp:integration": "node --import tsx --test tests/mcp/integration.test.ts",
    "mcp:start": "node --import tsx mcp/server.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:mcp": "tsc -p tsconfig.mcp.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "^5.90.0",
    "framer-motion": "^12.23.0",
    "konva": "^10.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-konva": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "socket.io-client": "^4.8.0",
    "use-image": "^1.1.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13"
  },
  "type": "module"
}
