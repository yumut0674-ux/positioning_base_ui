{
  "name": "gekon-ips-control",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --hostname 0.0.0.0",
    "build": "vinext build",
    "start": "vinext start",
    "postinstall": "node scripts/patch-vinext-windows-static-assets.mjs",
    "start:share": "node scripts/start-share.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:mcp": "node --import tsx --test tests/mcp/all.test.ts",
    "test:tracking": "node --import tsx --test tests/trackingIngest.test.ts tests/trackingPdop.test.ts tests/mapPdopFilter.test.ts tests/regionPositionEngine.test.ts tests/stepDistanceFilter.test.ts tests/roomExitRegression.test.ts tests/processedPositionServer.test.ts tests/regionEngineApi.test.ts tests/regionEngineStartup.test.ts tests/positionAnimationController.test.ts tests/positionFilters.test.ts tests/tagUpdateOrdering.test.ts tests/demoSharing.test.ts tests/tagSimulator.test.mjs tests/legacyRegionPositionEngine.test.ts tests/roomDecisionPersistence.test.ts tests/areaTransitions.test.ts",
    "test:maps": "node --import tsx --test tests/mapCatalog.test.ts tests/intensiveCareRooms.test.ts tests/serviceRooms.test.ts tests/mapSelection.test.ts tests/mapViewportConfig.test.ts tests/mapTouchGesture.test.ts tests/htmlTagOverlay.test.ts tests/mapDisplayFilter.test.ts tests/regionRawTagLayer.test.ts tests/multifloorTracking.test.ts tests/tagTrail.test.ts tests/tagManagementPanel.test.ts tests/areaTransitions.test.ts",
    "test:maps:legacy": "node --import tsx --test tests/mapRegionGeometry.test.ts",
    "test:mcp:integration": "node --import tsx --test tests/mcp/integration.test.ts",
    "test:ai": "node --import tsx tests/ai-evaluation/runner/run-evaluation.ts",
    "test:ai:offline": "node --import tsx tests/ai-evaluation/runner/run-evaluation.ts --offline",
    "test:ai:usage-policy": "node --import tsx tests/ai-evaluation/runner/run-usage-policy.ts",
    "test:ai:location": "node --import tsx --test tests/assistantLocation.test.ts tests/assistantConversation.test.ts",
    "test:ai:admin": "node --import tsx --test tests/assistantManagement.test.ts tests/dualUi.test.ts",
    "test:ai:admin:db": "node --env-file=.env.local --import tsx --test tests/assistantManagementDb.test.ts",
    "setup:ai-admin": "node scripts/setup-assistant-admin.mjs",
    "test:ai:location:live": "node --import tsx tests/ai-evaluation/runner/run-location-live.ts",
    "mcp:start": "node --import tsx mcp/server.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:mcp": "tsc -p tsconfig.mcp.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "simulate:rooms": "node test_api/simulate_tags.js",
    "evaluate:rooms": "node --import tsx test_api/evaluate_rooms.ts",
    "migrate:rooms": "node --env-file=.env.local --import tsx scripts/migrate-room-decisions.ts",
    "test:rooms:db": "node --env-file=.env.local --import tsx --test tests/roomDecisionPersistence.test.ts",
    "test:room-tests": "node --import tsx --test tests/roomTests.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "^5.90.0",
    "framer-motion": "^12.23.0",
    "konva": "^10.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "pdfmake": "^0.2.20",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-konva": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "socket.io-client": "^4.8.0",
    "use-image": "^1.1.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pdfmake": "^0.2.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13"
  },
  "type": "module"
}
