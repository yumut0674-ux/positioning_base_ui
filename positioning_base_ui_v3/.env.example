# Main Vinext application. Keep the shared demo listener on loopback port 3000.
PORT=3000
RAW_POSITION_PORT=3000

# Processed Region Position Engine HTTP + SSE output (server-side only)
REGION_POSITION_HOST=127.0.0.1
REGION_POSITION_PORT=3001
REGION_BROADCAST_INTERVAL_MS=1000

# Direct browser access to this service is not required; the UI uses the same-origin proxy.
REGION_POSITION_ALLOWED_ORIGIN=http://127.0.0.1:3000

# PostgreSQL is local-only. Do not bind or publish port 5432 to the Internet.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=uwb_db
POSTGRES_USER=uwb_user
POSTGRES_PASSWORD=CHANGE_ME

# Location API and read-only MCP client tuning
UWB_LOCATION_API_BASE_URL=http://127.0.0.1:3000
UWB_LOCATION_API_TOKEN=
UWB_LOCATION_API_TIMEOUT_MS=5000
UWB_LIVE_THRESHOLD_SECONDS=30
UWB_OFFLINE_THRESHOLD_SECONDS=300
UWB_HISTORY_MAX_DAYS=7
UWB_HISTORY_MAX_POINTS=2000
UWB_HISTORY_PROCESSING_MAX_POINTS=100000

# Optional local Gemini assistant. Leave CHATBOT_SERVICE_URL empty when it is not running.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
CHATBOT_SERVICE_URL=
# When enabled, use only this loopback form: http://127.0.0.1:8000
UWB_NODE_COMMAND=

# Gekon AI management password, server-side only (minimum 16 characters).
# Run `npm run setup:ai-admin` to generate a password in ignored .env.local.
GEKON_AI_ADMIN_PASSWORD=

# Optional ingest simulator
TRACKING_INGEST_URL=http://127.0.0.1:3000/api/tracking/ingest
SIMULATOR_MIN_INTERVAL_MS=1000
SIMULATOR_MAX_INTERVAL_MS=1000

# Set a secret shared with the tracking source before accepting independent source heartbeats.
TRACKING_HEALTH_TOKEN=
# Optional durable area event spool; keep it on persistent local storage.
AREA_TRANSITION_SPOOL_DIR=

# Documentation-only placeholders for the Cloudflare dashboard; the application does not read them.
DEMO_DOMAIN=demo.example.com
ALLOWED_EMAIL=<ALLOWED_EMAIL>

# Never store a real password, Cloudflare tunnel token, tunnel UUID credential JSON,
# or personal email address in this file or in source control.
