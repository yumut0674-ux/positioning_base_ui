# Existing raw HTTP ingest + SSE application port
RAW_POSITION_PORT=3000

# Optional Region Position Engine HTTP + SSE output port
REGION_POSITION_PORT=3001
REGION_BROADCAST_INTERVAL_MS=1000

# Use a specific UI origin in production, for example http://127.0.0.1:3000
REGION_POSITION_ALLOWED_ORIGIN=*

# PostgreSQL connection used by REST APIs and tracking history persistence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=uwb_db
POSTGRES_USER=uwb_user
POSTGRES_PASSWORD=uwb_local_123456

# Location API and read-only MCP client tuning
UWB_LOCATION_API_BASE_URL=http://127.0.0.1:3000
UWB_LOCATION_API_TOKEN=
UWB_LOCATION_API_TIMEOUT_MS=5000
UWB_LIVE_THRESHOLD_SECONDS=30
UWB_OFFLINE_THRESHOLD_SECONDS=300
UWB_HISTORY_MAX_DAYS=7
UWB_HISTORY_MAX_POINTS=2000
UWB_HISTORY_PROCESSING_MAX_POINTS=100000

# Optional local Gemini assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
CHATBOT_SERVICE_URL=http://127.0.0.1:8000
UWB_NODE_COMMAND=

# Optional ingest simulator
TRACKING_INGEST_URL=http://localhost:3000/api/tracking/ingest
SIMULATOR_MIN_INTERVAL_MS=1000
SIMULATOR_MAX_INTERVAL_MS=1000
